# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# AI Engine — "claude" uses Claude CLI, "openai" uses OpenAI API
AI_ENGINE=claude

# OpenAI API Key (only needed if AI_ENGINE=openai)
OPENAI_API_KEY=

# GitHub Personal Access Token (optional — for private repos and higher rate limits)
GITHUB_TOKEN=

# Where to clone repos locally
REPOS_BASE_DIR=./repos

# SQLite database path
DB_PATH=./data/ai-agent.db

# Analysis timeout in seconds
ANALYSIS_TIMEOUT_SEC=300

# Max file size to analyze (bytes) — skip files larger than this
MAX_FILE_SIZE_BYTES=500000

# Allowed Telegram user IDs (comma-separated, leave empty to allow all)
ALLOWED_USER_IDS=
