# ─────────────────────────────────────────────────────────────────────────────
# ECR Dev Factory — environment configuration
# Copy to .env and fill in. Validated at startup by src/config.ts (Zod);
# the process exits with a list of problems if anything required is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Slack (required) ─────────────────────────────────────────────────────────
# Bot User OAuth Token (OAuth & Permissions page). Must start with xoxb-
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Basic Information -> App Credentials -> Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret
# App-level token with the connections:write scope (Socket Mode). Must start with xapp-
SLACK_APP_TOKEN=xapp-your-app-token

# ── Access control (required) ────────────────────────────────────────────────
# Slack user ID (U...) of the single admin who approves requests and plans
# and who may use /ecr-resume.
ADMIN_USER_ID=U0123456789

# ── Monorepo (required) ──────────────────────────────────────────────────────
# Absolute path to a local clone of the Nx/NestJS monorepo
MONOREPO_ROOT=/absolute/path/to/monorepo
# Nx project name used for `nx lint <name>` / `nx test <name>` and as the
# conventional-commit scope
MY_SERVICE=electronic-cash-register
# Repo-relative path of that service
MY_SERVICE_PATH=apps/electronic-cash-register

# Optional: comma-separated repo-relative paths the pipeline may touch.
# Defaults to MY_SERVICE_PATH. Matching is per path segment, so
# "apps/ecr" does NOT allow "apps/ecr-other".
# ALLOWED_SERVICE_PATHS=apps/electronic-cash-register,libs/ecr-shared

# ── Git (optional) ───────────────────────────────────────────────────────────
# Name of the git remote to fetch from / push to (despite the name, any
# remote works — typically your GitLab remote)
# GITHUB_REMOTE=origin
# Branch new work is based on and MRs target
# DEFAULT_BASE_BRANCH=main

# ── GitLab (required) ────────────────────────────────────────────────────────
# Numeric project ID or URL-encoded path (e.g. group%2Frepo)
GITLAB_PROJECT_ID=12345
GITLAB_HOST=https://gitlab.example.com
# Token with `api` scope (used by glab and the REST fallback)
GITLAB_TOKEN=glpat-your-token

# ── MR reviewers (optional) ──────────────────────────────────────────────────
# Comma-separated Slack user IDs offered in the "MR Reviewer(s)" dropdown.
# If unset, the form shows a picker with all workspace members.
# REVIEWER_USER_IDS=U0AAA,U0BBB
# Explicit Slack -> GitLab username mapping used to assign MR reviewers.
# Users not listed are resolved by matching their Slack email in GitLab.
# SLACK_TO_GITLAB_MAP=U0AAA:jane.doe,U0BBB:john.smith

# ── Pipeline tuning (optional) ───────────────────────────────────────────────
# Max review -> fix iterations per task (1-10). Counted across resumes.
# MAX_REVIEW_ITERATIONS=3
# Where per-task git worktrees are created
# WORKTREE_BASE_DIR=/tmp/ecr-worktrees
# Minutes a plan may wait for approval before it is cancelled (min 5)
# TASK_TTL_MINUTES=60
# Per-user cooldown between /ecr invocations, in seconds (min 5)
# RATE_LIMIT_SECONDS=30
# SQLite database file
# DB_PATH=./data/ecr-factory.db

# ── Logging (optional) ───────────────────────────────────────────────────────
# debug | info | warn | error (default: debug)
# LOG_LEVEL=info
