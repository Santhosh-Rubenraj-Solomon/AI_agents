# Copy to .env at the repo root (docker-compose reads it automatically) or export
# OPENAI_API_KEY in your shell before running `docker compose up`.
OPENAI_API_KEY=sk-...your-key...

# REQUIRED: shared secret for webhook HMAC-SHA256 signatures (X-Signature header).
# Without it every POST /webhook/* is rejected with 401 (fail closed).
# Generate one with:  openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional replay protection (defaults shown). If the sender includes an
# X-Signature-Timestamp header (Unix seconds), the signature must cover
# "<timestamp>.<raw body>" and the timestamp must be within the tolerance.
# Set WEBHOOK_REQUIRE_TIMESTAMP=true to reject signatures without a timestamp.
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_REQUIRE_TIMESTAMP=false

# Optional overrides (defaults shown)
PORT=3000
REDIS_HOST=redis
REDIS_PORT=6379
DATABASE_URL=postgres://ledger:ledger@postgres:5432/ledger
