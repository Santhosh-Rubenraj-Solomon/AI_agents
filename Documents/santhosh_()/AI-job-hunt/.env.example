# AI Provider (Google Gemini — free key at https://aistudio.google.com/apikey — used for résumé tailoring)
GOOGLE_API_KEY=your-gemini-api-key-here

# Job data source — Adzuna (free real listings). Sign up at https://developer.adzuna.com/
# Live jobs turn ON automatically once BOTH of these are set — no code change needed.
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# Job Portals (credentials stored securely — never commit .env)
LINKEDIN_EMAIL=you@email.com
LINKEDIN_PASSWORD=yourpassword
NAUKRI_EMAIL=you@email.com
NAUKRI_PASSWORD=yourpassword
INDEED_EMAIL=you@email.com
INDEED_PASSWORD=yourpassword

# Notification Channel (choose one or more)
NOTIFICATION_CHANNEL=email  # email | slack | whatsapp

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-specific-password
NOTIFY_EMAIL_TO=you@gmail.com

# Slack (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# WhatsApp via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# Database
DATABASE_URL=sqlite:///db/jobhunt.db
